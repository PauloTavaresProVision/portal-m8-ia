# Copiar este ficheiro para ".env" e preencher.

# Chave da API da Anthropic (platform.claude.com → Settings → API Keys). Obrigatória fora do modo demo.
ANTHROPIC_API_KEY=

# PIN do painel do formador (http://localhost:3000/painel). Escolher um PIN só seu.
FORMADOR_PIN=

# Modelo da IA. Por omissão: claude-opus-5-5 (o mais capaz).
# Para gastar menos: claude-sonnet-5-5
MODELO=claude-opus-5-5

# Esforço de raciocínio: low | medium | high  (medium é um bom equilíbrio entre qualidade e rapidez)
ESFORCO=medium

# Máximo de mensagens ao chat por formando em cada turma
LIMITE_MENSAGENS=80

# Porta do portal
PORTA=3000

# Só no servidor (online): palavra-passe da sala, pedida num ecrã como o do PIN. Vazio = sem palavra-passe (rede da sala).
SENHA_SALA=

# Fuso horário da operação (para as horas de presença)
FUSO=Africa/Luanda

# 1 = modo de demonstração: o chat responde com textos fixos, sem IA e sem custos
MODO_DEMO=0

# GoContact (final ao vivo): chave da API da operação TAAG (api-gocontact.ucall.co.ao → Apps)
GOCONTACT_API_KEY=
GOCONTACT_URL=https://api-gocontact.ucall.co.ao
GOCONTACT_INSTANCIA=taag
